generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum AgentType {
  CLIENT
  INTERNAL
}

enum AgentRole {
  REDACTOR
  DESIGNER
  FUNNEL
  DEVELOPER
  MEDIA_BUYER
  COMMERCIAL
  COMMUNITY
  CUSTOM
}

enum AgentStatus {
  ONLINE
  BUSY
  OFFLINE
}

enum MessageRole {
  USER
  AGENT
  SYSTEM
}

enum MessageStatus {
  PENDING
  VALIDATED
  REVISED
  REJECTED
}

enum ConversationChannel {
  WEB
  WHATSAPP
}

model User {
  id            Int              @id @default(autoincrement())
  email         String           @unique
  password      String
  name          String
  role          UserRole         @default(EMPLOYEE)
  // Numéro WhatsApp au format E.164 sans "+" (ex: 33612345678), utilisé pour
  // identifier l'employé qui écrit depuis le numéro partagé de l'agence.
  phone         String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  conversations Conversation[]
  messages      Message[]
  agentsCreated Agent[]          @relation("AgentCreator")
  assignments   AgentAssignment[]
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  company   String?
  email     String?
  // Mots-clés séparés par des virgules utilisés par le routeur WhatsApp pour
  // reconnaître ce client quand un employé le nomme dans son message
  // (ex: "dupont,dupont sarl,client dupont").
  keywords  String?
  createdAt DateTime @default(now())
  agents    Agent[]
}

model Agent {
  id            Int            @id @default(autoincrement())
  name          String
  type          AgentType      @default(CLIENT)
  role          AgentRole      @default(CUSTOM)
  systemPrompt  String         @db.Text
  status        AgentStatus    @default(OFFLINE)
  tasksCount    Int            @default(0)
  quality       Float          @default(95)
  hoursSaved    Float          @default(0)
  weeklyGoal    Float          @default(50)
  clientId      Int?
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdById   Int?
  createdBy     User?          @relation("AgentCreator", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  assignments   AgentAssignment[]
}

// Table de correspondance employé ↔ sous-agent. Un même agent (ex: "Rédacteur
// Client 1") peut être partagé par plusieurs employés, et un employé peut
// avoir accès à plusieurs agents (rôles/clients différents) — cf. "ça dépend
// du client/projet".
model AgentAssignment {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   Int
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, agentId])
}

model Conversation {
  id        Int                 @id @default(autoincrement())
  title     String              @default("Nouvelle conversation")
  channel   ConversationChannel @default(WEB)
  agentId   Int
  agent     Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  messages  Message[]
}

model Message {
  id             Int           @id @default(autoincrement())
  content        String        @db.Text
  role           MessageRole
  status         MessageStatus @default(PENDING)
  conversationId Int
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int?
  user           User?         @relation(fields: [userId], references: [id])
  createdAt      DateTime      @default(now())
}