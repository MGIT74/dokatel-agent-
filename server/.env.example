DATABASE_URL="mysql://dokatel:dokatel_password@localhost:3306/dokatel"
JWT_SECRET="changez-moi-avec-une-longue-phrase-secrete"
PORT=4000
CLIENT_URL="http://localhost:5173"

# Hermes / n8n (laisser vide = mode démo)
HERMES_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET="dokatel-secret"

# WhatsApp (connecteur Baileys, gratuit/non-officiel — usage interne agence)
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_DIR="./whatsapp-session"
# En groupe, le bot n'intervient que si le message commence par ce préfixe
WHATSAPP_BOT_PREFIX="/agent"
WHATSAPP_ALLOW_GROUPS=true
WHATSAPP_LOG_LEVEL=silent